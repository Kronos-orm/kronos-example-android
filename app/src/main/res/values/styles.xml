<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KronosExample" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/header</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="SegmentButton">
        <item name="android:layout_width">84dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:background">@drawable/bg_segment_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FormatButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">7dp</item>
        <item name="android:background">@drawable/bg_format_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ToolbarIconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">12dp</item>
        <item name="android:tint">@android:color/white</item>
    </style>
</resources>
